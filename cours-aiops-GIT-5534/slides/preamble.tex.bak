\documentclass[10pt,aspectratio=169]{beamer}

\usepackage{fontspec}
\usepackage{polyglossia}
\setdefaultlanguage{french}
\usepackage{amsmath,amssymb,mathtools}
\usepackage{unicode-math}
\usepackage{booktabs}
\usepackage{array}
\usepackage{colortbl}
\usepackage{xcolor}
\usepackage{tikz}
\usetikzlibrary{arrows.meta,positioning,calc,shapes.geometric,fit,backgrounds,patterns}
\usepackage{pgfplots}
\pgfplotsset{compat=1.18}
\usepgfplotslibrary{fillbetween}
\usepackage{graphicx}
\usepackage{listings}
\usepackage[most]{tcolorbox}
\tcbuselibrary{skins,breakable}
\usepackage{fontawesome5}
\usepackage{multicol}
\usepackage{multirow}
\usepackage{animate}

% ---------------------------------------------------------------- theme
\usetheme{default}
\usecolortheme{default}
\setbeamertemplate{navigation symbols}{}

\definecolor{byDeep}   {HTML}{10243E}
\definecolor{byBlue}   {HTML}{1F6FEB}
\definecolor{byCyan}   {HTML}{12A594}
\definecolor{byOrange} {HTML}{D97706}
\definecolor{byRed}    {HTML}{C0392B}
\definecolor{byGreen}  {HTML}{1E8449}
\definecolor{byPurple} {HTML}{6C5CE7}
\definecolor{byGrey}   {HTML}{5B6470}
\definecolor{byLight}  {HTML}{F4F6F8}

\setbeamercolor{frametitle}{bg=byDeep,fg=white}
\setbeamercolor{structure}{fg=byBlue}
\setbeamercolor{normal text}{fg=byDeep}
\setbeamercolor{alerted text}{fg=byRed}
\setbeamercolor{title}{fg=white}
\setbeamercolor{subtitle}{fg=white}
\setbeamercolor{author}{fg=white}
\setbeamercolor{date}{fg=white}
\setbeamercolor{item}{fg=byBlue}
\setbeamercolor{section in toc}{fg=byDeep}
\setbeamercolor{block title}{bg=byBlue!12,fg=byDeep}
\setbeamercolor{block body}{bg=byBlue!5}

\setbeamerfont{frametitle}{size=\large,series=\bfseries}
\setbeamerfont{title}{size=\LARGE,series=\bfseries}
\setbeamerfont{block title}{series=\bfseries}

% gain de place vertical : le titre de frame est suivi d'un espace negatif
% (les supports sont denses ; cela evite que le dernier encadre morde sur le pied de page)
\addtobeamertemplate{frametitle}{}{\vspace*{-4.0mm}}
\setlength{\abovedisplayskip}{3pt}
\setlength{\belowdisplayskip}{3pt}
\setlength{\abovedisplayshortskip}{2pt}
\setlength{\belowdisplayshortskip}{2pt}

\setbeamertemplate{itemize item}{\small\raise0.2ex\hbox{\textcolor{byBlue}{$\blacktriangleright$}}}
\setbeamertemplate{itemize subitem}{\tiny\raise0.35ex\hbox{\textcolor{byCyan}{$\bullet$}}}
\setlength{\tabcolsep}{3pt}   % tableaux plus etroits (les slides sont denses)
% listes plus compactes : les supports sont denses et le pied de page mange de la place
\setbeamertemplate{itemize/enumerate body begin}{\vspace*{-2.0mm}}
\setbeamertemplate{itemize/enumerate subbody begin}{\vspace*{-0.6mm}}
\setbeamertemplate{enumerate item}{\textcolor{byBlue}{\bfseries\insertenumlabel.}}
\setbeamertemplate{caption}[numbered]

% footer : chapitre | slide n/N
\setbeamertemplate{footline}{%
  % Beamer reserve la hauteur de cette boite comme zone interdite : le vskip
  % ci-dessous cale la zone de texte exactement au-dessus de la barre visible.
  \vskip 10mm%
  \leavevmode%
  \hbox{%
    \begin{beamercolorbox}[wd=.32\paperwidth,ht=1.9ex,dp=0.8ex,leftskip=.3cm]{author in head/foot}%
      \usebeamerfont{author in head/foot}\color{white}\scriptsize\insertshorttitle
    \end{beamercolorbox}%
    \begin{beamercolorbox}[wd=.52\paperwidth,ht=1.9ex,dp=0.8ex,center]{title in head/foot}%
      \usebeamerfont{title in head/foot}\color{white}\scriptsize Par Dr. Noulapeu Ngaffo Armielle
    \end{beamercolorbox}%
    \begin{beamercolorbox}[wd=.16\paperwidth,ht=1.9ex,dp=0.8ex,rightskip=.3cm]{date in head/foot}%
      \usebeamerfont{date in head/foot}\color{white}\scriptsize\insertframenumber\,/\,\inserttotalframenumber
    \end{beamercolorbox}}%
  \vskip0pt%
}
\setbeamercolor{author in head/foot}{bg=byDeep}
\setbeamercolor{title in head/foot}{bg=byDeep!88}
\setbeamercolor{date in head/foot}{bg=byDeep!76}

\setbeamertemplate{title page}{%
  \begin{tikzpicture}[remember picture,overlay]
    \fill[byDeep] (current page.north west) rectangle (current page.south east);
    \fill[byBlue,opacity=.30] (current page.north east) ++(-3.2,-1.1) circle (5.4cm);
    \fill[byCyan,opacity=.18] (current page.south west) ++(2.2,1.0) circle (4.2cm);
  \end{tikzpicture}
  \vspace{1.1cm}
  \begin{center}
    {\usebeamerfont{title}\usebeamercolor[fg]{title}\inserttitle\par}
    \vspace{.25cm}
    {\large\color{byCyan}\insertsubtitle\par}
    \vspace{.7cm}
    {\color{white}\small\insertauthor\par}
    \vspace{.15cm}
    {\color{white!80}\footnotesize\insertinstitute\par}
    \vspace{.15cm}
    {\color{white!70}\footnotesize\insertdate\par}
  \end{center}
}

% ------------------------------------------------------- boites maison
\newtcolorbox{qbox}[1][QUIZ]{%
  enhanced,colback=byOrange!7,colframe=byOrange,boxrule=.9pt,arc=2mm,
  left=2mm,right=2mm,top=3.4mm,bottom=1.2mm,
  title={\faQuestionCircle\ \bfseries #1},fonttitle=\bfseries\scriptsize\color{white},
  colbacktitle=byOrange,attach boxed title to top left={xshift=3mm,yshift=-2mm},
  boxed title style={arc=1mm,boxrule=0pt}}

\newtcolorbox{abox}[1][ACTIVITE]{%
  enhanced,colback=byBlue!6,colframe=byBlue,boxrule=.9pt,arc=2mm,
  left=2mm,right=2mm,top=3.4mm,bottom=1.2mm,
  title={\faUsers\ \bfseries #1},fonttitle=\bfseries\scriptsize\color{white},
  colbacktitle=byBlue,attach boxed title to top left={xshift=3mm,yshift=-2mm},
  boxed title style={arc=1mm,boxrule=0pt}}

\newtcolorbox{ebox}[1][EXEMPLE]{%
  enhanced,colback=byGreen!6,colframe=byGreen,boxrule=.9pt,arc=2mm,
  left=2mm,right=2mm,top=3.4mm,bottom=1.2mm,
  title={\faFlask\ \bfseries #1},fonttitle=\bfseries\scriptsize\color{white},
  colbacktitle=byGreen,attach boxed title to top left={xshift=3mm,yshift=-2mm},
  boxed title style={arc=1mm,boxrule=0pt}}

\newtcolorbox{kbox}[1][A RETENIR]{%
  enhanced,colback=byPurple!6,colframe=byPurple,boxrule=.9pt,arc=2mm,
  left=2mm,right=2mm,top=3.4mm,bottom=1.2mm,
  title={\faLightbulb\ \bfseries #1},fonttitle=\bfseries\scriptsize\color{white},
  colbacktitle=byPurple,attach boxed title to top left={xshift=3mm,yshift=-2mm},
  boxed title style={arc=1mm,boxrule=0pt}}

\newtcolorbox{wbox}[1][ATTENTION]{%
  enhanced,colback=byRed!6,colframe=byRed,boxrule=.9pt,arc=2mm,
  left=2mm,right=2mm,top=3.4mm,bottom=1.2mm,
  title={\faExclamationTriangle\ \bfseries #1},fonttitle=\bfseries\scriptsize\color{white},
  colbacktitle=byRed,attach boxed title to top left={xshift=3mm,yshift=-2mm},
  boxed title style={arc=1mm,boxrule=0pt}}

\newtcolorbox{solbox}[1][SOLUTION]{%
  enhanced,colback=byCyan!7,colframe=byCyan,boxrule=.9pt,arc=2mm,
  left=2mm,right=2mm,top=3.4mm,bottom=1.2mm,
  title={\faCheckCircle\ \bfseries #1},fonttitle=\bfseries\scriptsize\color{white},
  colbacktitle=byCyan,attach boxed title to top left={xshift=3mm,yshift=-2mm},
  boxed title style={arc=1mm,boxrule=0pt}}

\newtcolorbox{codebox}[1][Code Python]{%
  enhanced,colback=byLight,colframe=byGrey!60,boxrule=.6pt,arc=1.5mm,
  left=1.5mm,right=1.5mm,top=3.8mm,bottom=1.0mm,
  title={\faPython\ \ttfamily\small #1},fonttitle=\small\color{white},
  colbacktitle=byGrey,attach boxed title to top left={xshift=3mm,yshift=-2mm},
  boxed title style={arc=1mm,boxrule=0pt}}

\newtcolorbox{figbox}[1][]{%
  enhanced,colback=white,colframe=byDeep!25,boxrule=.6pt,arc=1.5mm,
  left=1mm,right=1mm,top=1mm,bottom=1mm,#1}

% --------------------------------------------------------- listings
\definecolor{codekw}{HTML}{0B5394}
\definecolor{codestr}{HTML}{B8531A}
\definecolor{codecom}{HTML}{57744E}
\definecolor{codebg}{HTML}{F6F8FA}
\lstdefinestyle{py}{
  language=Python,
  backgroundcolor=\color{codebg},
  basicstyle=\ttfamily\fontsize{6.6}{7.6}\selectfont,
  keywordstyle=\color{codekw}\bfseries,
  commentstyle=\color{codecom}\itshape,
  stringstyle=\color{codestr},
  numberstyle=\tiny\color{byGrey},
  numbers=left,numbersep=4pt,
  frame=none,
  breaklines=true,breakatwhitespace=false,
  showstringspaces=false,
  columns=fullflexible,keepspaces=true,
  upquote=true,
  literate={é}{{\'e}}1 {è}{{\`e}}1 {ê}{{\^e}}1 {à}{{\`a}}1 {â}{{\^a}}1
           {î}{{\^i}}1 {ô}{{\^o}}1 {û}{{\^u}}1 {ç}{{\c c}}1 {ù}{{\`u}}1
           {É}{{\'E}}1 {È}{{\`E}}1 {À}{{\`A}}1 {Ê}{{\^E}}1 {Ç}{{\c C}}1
           {œ}{{\oe}}1 {’}{{'}}1 {«}{{\guillemotleft}}1 {»}{{\guillemotright}}1
           {→}{{$\rightarrow$}}1 {α}{{$\alpha$}}1 {β}{{$\beta$}}1 {θ}{{$\theta$}}1
           {μ}{{$\mu$}}1 {σ}{{$\sigma$}}1 {λ}{{$\lambda$}}1 {π}{{$\pi$}}1
           {τ}{{$\tau$}}1 {ρ}{{$\rho$}}1 {≈}{{$\approx$}}1 {≤}{{$\leq$}}1
           {≥}{{$\geq$}}1 {×}{{$\times$}}1 {≠}{{$\neq$}}1 {∈}{{$\in$}}1
}
\lstset{style=py}

\newcommand{\py}[1]{\lstinline[style=py,basicstyle=\ttfamily\small]|#1|}
\newcommand{\file}[1]{\texttt{\small #1}}
\newcommand{\R}{\mathbb{R}}
\newcommand{\N}{\mathcal{N}}
\newcommand{\E}{\mathbb{E}}
\newcommand{\Var}{\mathrm{Var}}
\newcommand{\post}{\text{post}}
\newcommand{\like}{\text{vrais.}}
\newcommand{\data}{\mathcal{D}}
\newcommand{\given}{\,\vert\,}
\DeclareMathOperator*{\argmax}{arg\,max}
\DeclareMathOperator*{\argmin}{arg\,min}

% icones de validation
\newcommand{\ok}{\textcolor{byGreen}{\faCheckCircle}}
\newcommand{\nok}{\textcolor{byRed}{\faTimesCircle}}
\newcommand{\warn}{\textcolor{byOrange}{\faExclamationTriangle}}

% chemin des figures
\graphicspath{{../figures/}{./figures/}{figures/}{../assets/}{./assets/}}

% ------------------------------------------------ page de garde de chapitre
% A utiliser en tete de chaque fichier de chapitre : identique en build
% autonome et en build maitre (aucune dependance a \title).
\newcommand{\chapterslide}[4]{%
\begin{frame}[plain]
\begin{tikzpicture}[remember picture,overlay]
  \fill[byDeep] (current page.north west) rectangle (current page.south east);
  \fill[byBlue,opacity=.30] (current page.north east) ++(-3.0,-0.9) circle (5.0cm);
  \fill[byCyan,opacity=.16] (current page.south west) ++(2.4,1.2) circle (4.4cm);
\end{tikzpicture}
\vspace{0.55cm}
\begin{columns}[c]
% ---- logo officiel de l'ecole, dans un cartouche blanc
\begin{column}{0.20\textwidth}
  \centering
  \begin{tcolorbox}[colback=white,colframe=white,boxrule=0pt,arc=1.5mm,
     left=1mm,right=1mm,top=1mm,bottom=1mm,width=2.5cm]
    \centering
    \includegraphics[width=2.1cm]{logo_enspd.png}
  \end{tcolorbox}
\end{column}
% ---- identification du chapitre et de l'enseignante
\begin{column}{0.76\textwidth}
  {\color{byCyan}\bfseries\large #1\par}
  \vspace{.20cm}
  {\color{white}\bfseries\Large #2\par}
  \vspace{.30cm}
  {\color{white!85}\small Apprentissage automatique appliqué aux infrastructures --- EPD-GIT-5534\par}
  \vspace{.06cm}
  {\color{white!70}\footnotesize #3\par}
  \vspace{.26cm}
  {\color{byCyan}\bfseries\normalsize Enseignante : Dr. Noulapeu Ngaffo Armielle\par}
  \vspace{.06cm}
  {\color{white!80}\footnotesize École Nationale Supérieure Polytechnique de Douala\par}
  {\color{white!65}\footnotesize Université de Douala --- Département Génie Informatique
   et Télécommunications\par}
\end{column}
\end{columns}
\vspace{.30cm}
\begin{columns}[t]
\begin{column}{0.06\textwidth}\end{column}
\begin{column}{0.88\textwidth}
\begin{tcolorbox}[enhanced,colback=byDeep!62!black,colframe=byCyan!75,arc=2mm,
   boxrule=.6pt,left=2mm,right=2mm,top=1.4mm,bottom=1.4mm,coltext=white]
\small #4
\end{tcolorbox}
\end{column}
\begin{column}{0.06\textwidth}\end{column}
\end{columns}
\end{frame}}

